# Helium Discord Bot — Environment Template
# Author: req.akira aka ScraperDevBD (scraperdev.bd@gmail.com)
# Community: https://discord.gg/rQbFHJYnCK

# Discord Bot Credentials (Obtain from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here

# Default Bot Settings
DEFAULT_PREFIX=&
OWNER_IDS=your_discord_user_id_here

# SQLite Database Storage Location
DATABASE_PATH=./data/helium.db

# Web Command Center Dashboard
ADMIN_DASHBOARD_KEY=2026
DASHBOARD_PORT=3000
DASHBOARD_URL=http://localhost:3000

# Environment Mode (development / production)
NODE_ENV=production
